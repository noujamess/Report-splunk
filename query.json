{
  "version": 1,
  "description": "Deploy example query set for Project Report.",
  "queries": [
    {
      "source": "splunk",
      "query_type": "splunk_search",
      "device": "all_run",
      "site": "all",
      "query_name": "Saved_Search_Summary",
      "query_template": "| rest /services/saved/searches | search title=\"*{site_names} - *\" | eval status=case(disabled=\"1\",\"Disable\",disabled=\"0\",\"Enable\") | table status title",
      "index_pattern": null,
      "enabled": true
    },
    {
      "source": "splunk",
      "query_type": "splunk_search",
      "device": "fortigate",
      "site": "all",
      "query_name": "Fortigate_Login_Failed",
      "query_template": "search index={index} \"login failed\" | stats count by src duser host reason | rename host AS dhost | table src duser dhost reason count",
      "index_pattern": null,
      "enabled": true
    },
    {
      "source": "elk",
      "query_type": "elk_search",
      "device": "all",
      "site": "all",
      "query_name": "Receiver_Usecase_Summary",
      "query_template": "revid:{receiver_id}",
      "index_pattern": "casecbt-v01",
      "time_field": "created",
      "group_by_field": "usecase.keyword",
      "result_fields": [
        "usecase",
        "count"
      ],
      "elk_server": "primary",
      "enabled": true
    },
    {
      "source": "elk",
      "query_type": "elk_search",
      "device": "wineventlog",
      "site": "all",
      "query_name": "Windows_4624_Summary",
      "query_template": "externalId:4624 AND NOT duser:*$",
      "index_pattern": "{elk_name}-win*",
      "time_field": "@timestamp",
      "group_by_field": "usecase.keyword",
      "result_fields": [
        "duser",
        "src",
        "outcome",
        "logintype",
        "count"
      ],
      "elk_server": "secondary",
      "enabled": true
    }
  ]
}
