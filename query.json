{
  "version": 1,
  "description": "Deploy example query set for Project Report.",
  "queries": [
    {
      "source": "splunk",
      "query_type": "splunk_search",
      "device": "all_run",
      "site": "all",
      "query_name": "",
      "query_template": "| rest /services/saved/searches | search title=\"*{site_names} - *\" | eval status=case(disabled=\"1\",\"Disable\",disabled=\"0\",\"Enable\") | table status title",
      "index_pattern": null,
      "enabled": true
    },
    {
      "source": "splunk",
      "query_type": "splunk_search",
      "device": "",
      "site": "all",
      "query_name": "",
      "query_template": "search index={index}",
      "index_pattern": null,
      "enabled": true
    },
    {
      "source": "elk",
      "query_type": "elk_search",
      "device": "all",
      "site": "all",
      "query_name": "",
      "query_template": "",
      "index_pattern": "",
      "time_field": "created",
      "group_by_field": "",
      "result_fields": [
        "",
        ""
      ],
      "elk_server": "primary",
      "enabled": true
    },
    {
      "source": "elk",
      "query_type": "elk_search",
      "device": "",
      "site": "all",
      "query_name": "",
      "query_template": "",
      "index_pattern": "created",
      "time_field": "@timestamp",
      "group_by_field": "",
      "result_fields": [
        ""
      ],
      "elk_server": "secondary",
      "enabled": true
    }
  ]
}
