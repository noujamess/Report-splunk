# Application
PORT=5000
UVICORN_RELOAD=false
ALLOWED_ORIGINS=*
# Example:
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ALLOWED_ORIGIN_REGEX=http://192\.168\.1\..*

# MongoDB
MONGO_URL=mongodb://your-mongodb-host:27017/
MONGO_DB_NAME=report
MONGO_COLLECTION_NAME=customer
MONGO_QUERY_COLLECTION_NAME=queries

# Splunk
SPLUNK_PORT=8089
SPLUNK_USER=your_splunk_user
SPLUNK_PASS=your_splunk_password
# Used by sync_splunk_to_mongodb.py to iterate source servers
SPLUNK_HOSTS=192.168.4.101,192.168.4.102

# ELK / Elasticsearch primary
ELK_SERVER_HOST=https://your-primary-elk-host:9200
ELK_USER=your_primary_elk_user
ELK_PASS=your_primary_elk_password

# ELK / Elasticsearch secondary
ELK_SERVER_2_HOST=https://your-secondary-elk-host:9200
ELK_SERVER_2_USER=your_secondary_elk_user
ELK_SERVER_2_PASS=your_secondary_elk_password

# Runtime tuning
MAX_CONCURRENT_SPLUNK_JOBS=5
MAX_CONCURRENT_ELK_JOBS=5
